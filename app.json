{
  "expo": {
    "name": "Regulars",
    "slug": "regulars",
    "scheme": "regulars",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nyc.regulars.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used once, to photograph your ID during verification. The image goes to our verification provider and is never stored by us."
      }
    },
    "android": {
      "package": "nyc.regulars.app",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "75b42d71-f715-4c88-86c7-3c5e75b40a0a"
      }
    },
    "owner": "jedex99"
  }
}
